          <span class="text-slate-400">Store:</span>
          <span id="headerDealerName" class="font-semibold text-slate-100">Cascade Ford</span>
          <span class="bg-blue-900/60 text-blue-300 font-mono text-[11px] px-2 py-0.5 rounded border border-blue-700/50" id="headerPaCode">PA: 04291</span>
        </div>
        <div class="h-3 w-px bg-slate-700"></div>
        <div class="flex items-center space-x-1.5 text-[11px] text-slate-400">
          <i data-lucide="calendar" class="w-3.5 h-3.5 text-slate-400"></i>
