        </button>

        <button id="presentModeBtn" class="flex items-center space-x-1.5 text-xs bg-blue-600 hover:bg-blue-500 text-white font-medium px-3 py-1.5 rounded-md transition shadow-sm">
          <i data-lucide="presentation" class="w-4 h-4"></i>
          <span>Present</span>
