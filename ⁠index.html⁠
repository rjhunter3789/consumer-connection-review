    /* =========================================================================
       APPLICATION STATE
       ========================================================================= */
    let currentDealerData = null;
    let activePageIndex = 0;
    let isPresentMode = false;

    /* =========================================================================
       CORE CONTROLLER METHODS
       ========================================================================= */
    function init() {
      // Setup Lucide icons
      lucide.createIcons();

      // Drawer toggle listeners
      document.getElementById('calendarDrawerBtn').addEventListener('click', () => {
        document.getElementById('calendarDrawer').classList.remove('hidden');
      });
      document.getElementById('closeDrawerBtn').addEventListener('click', () => {
        document.getElementById('calendarDrawer').classList.add('hidden');
      });

      // Presentation mode toggle
      document.getElementById('presentModeBtn').addEventListener('click', togglePresentMode);

      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        if (!currentDealerData || !currentDealerData.pages) return;
        if (e.key === 'ArrowRight' && activePageIndex < currentDealerData.pages.length - 1) {
          switchPage(activePageIndex + 1);
        } else if (e.key === 'ArrowLeft' && activePageIndex > 0) {
          switchPage(activePageIndex - 1);
        } else if (e.key === 'Escape' && isPresentMode) {
          togglePresentMode();
        }
      });

      // Default initial load: Scenario A (Cascade Ford)
      loadScenario('dealer_full');
    }

    function loadScenario(type) {
      document.getElementById('calendarDrawer').classList.add('hidden');

      if (type === 'dealer_full') {
        resolveDealerByPaCode('04291');
      } else if (type === 'dealer_single') {
        resolveDealerByPaCode('08174');
      } else if (type === 'dealer_two') {
        resolveDealerByPaCode('01550');
      } else if (type === 'error_unresolved') {
        showFallbackState(
          'alert-circle',
          'PA Code Resolution Failed',
          'The meeting invite text does not match any authorized dealer PA Code in the directory. Fuzzy matching is disabled by security policy.'
        );
      } else if (type === 'error_api') {
        showFallbackState(
          'server-crash',
          'Consumer Connection API 503 Outage',
          'The Consumer Connection backend service returned an HTTP 503 Unavailable status code. Front-end fallback engaged.'
        );
      }
    }

    function resolveDealerByPaCode(paCode) {
      // Deterministic key matching
      const data = DEALER_DATABASE[paCode];
      if (!data) {
        showFallbackState('alert-triangle', 'Dealer Not Found', `PA Code "${paCode}" is not authorized or has no active records.`);
        return;
      }

      currentDealerData = data;
      activePageIndex = 0;

      // Update header info
      document.getElementById('dealerHeaderPill').classList.remove('hidden');
      document.getElementById('headerDealerName').innerText = data.dealer.name;
      document.getElementById('headerPaCode').innerText = `PA: ${data.dealer.paCode}`;
      document.getElementById('headerDateRange').innerText = `${data.reportContext.startDate} – ${data.reportContext.endDate}`;
      document.getElementById('footerGeneratedAt').innerText = `Refreshed: ${data.reportContext.generatedAt}`;

      // Show main content, hide error states
      document.getElementById('activePageContent').classList.remove('hidden');
      document.getElementById('fallbackStateContent').classList.add('hidden');
      document.getElementById('pageNavContainer').classList.remove('hidden');

      // Render Dynamic Page Tabs (FR-05, dynamic 1-4 pages)
      renderNavigationTabs();

      // Render Current Page
      renderActivePage();
    }

    function showFallbackState(icon, title, message) {
      currentDealerData = null;
      document.getElementById('activePageContent').classList.add('hidden');
      document.getElementById('pageNavContainer').classList.add('hidden');
      document.getElementById('dealerHeaderPill').classList.add('hidden');
      
      const fallbackBox = document.getElementById('fallbackStateContent');
      fallbackBox.classList.remove('hidden');
      document.getElementById('fallbackTitle').innerText = title;
      document.getElementById('fallbackMessage').innerText = message;
      document.getElementById('pageCounterDisplay').innerText = 'Offline';

      lucide.createIcons();
    }

    function renderNavigationTabs() {
      const tabContainer = document.getElementById('pageTabList');
      tabContainer.innerHTML = '';

      currentDealerData.pages.forEach((page, index) => {
        const btn = document.createElement('button');
        btn.onclick = () => switchPage(index);
        
        const isActive = index === activePageIndex;
        btn.className = `px-3.5 py-1.5 rounded-md text-xs font-medium transition flex items-center space-x-2 ${
          isActive 
            ? 'bg-blue-600 text-white shadow-sm ring-1 ring-blue-400/50' 
            : 'bg-slate-700/60 hover:bg-slate-700 text-slate-300 hover:text-white'
        }`;

        btn.innerHTML = `
          <span class="w-4 h-4 rounded-full ${isActive ? 'bg-white/20' : 'bg-slate-600'} text-[10px] flex items-center justify-center font-bold">${index + 1}</span>
          <span>${page.title}</span>
        `;
        tabContainer.appendChild(btn);
      });

      updateCounter();
    }

    function switchPage(index) {
      activePageIndex = index;
      renderNavigationTabs();
      renderActivePage();
    }

    function updateCounter() {
      if (!currentDealerData) return;
      document.getElementById('pageCounterDisplay').innerText = `Page ${activePageIndex + 1} of ${currentDealerData.pages.length}`;
    }

    function togglePresentMode() {
      isPresentMode = !isPresentMode;
      const headers = document.querySelectorAll('.no-print');
      const presentBtn = document.getElementById('presentModeBtn');

      if (isPresentMode) {
        document.body.classList.add('bg-slate-950');
        presentBtn.innerHTML = `<i data-lucide="minimize" class="w-4 h-4"></i><span>Exit Present</span>`;
        presentBtn.classList.replace('bg-blue-600', 'bg-slate-700');
      } else {
        document.body.classList.remove('bg-slate-950');
        presentBtn.innerHTML = `<i data-lucide="presentation" class="w-4 h-4"></i><span>Present</span>`;
        presentBtn.classList.replace('bg-slate-700', 'bg-blue-600');
      }
      lucide.createIcons();
    }

    /* =========================================================================
       PAGE RENDER ENGINE (Generates Executive Cards + Benchmarks without wide tables)
       ========================================================================= */
    function renderActivePage() {
      const page = currentDealerData.pages[activePageIndex];
      const container = document.getElementById('activePageContent');

      let metricsHtml = page.metrics.map(m => `
        <div class="bg-slate-800/90 rounded-xl p-4 border ${m.highlight ? 'border-blue-500/80 bg-blue-950/20 shadow-lg shadow-blue-950/30 ring-1 ring-blue-500/40' : 'border-slate-700/80'} flex flex-col justify-between">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
            <span class="font-medium">${m.label}</span>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full ${m.highlight ? 'bg-blue-600/30 text-blue-300 border border-blue-500/40' : 'bg-slate-700 text-slate-300'}">${m.badge}</span>
          </div>
          <div class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight my-1 ${m.highlight ? 'text-blue-400' : ''}">
            ${m.value}
          </div>
          <div class="text-[11px] text-slate-400 flex items-center space-x-1">
            <span>${m.subtext}</span>
          </div>
        </div>
      `).join('');

      let detailSectionHtml = '';

      // If page has a synthesized table breakdown (replaces 25-column source monster)
      if (page.breakdownRows) {
        const headerCols = page.breakdownHeaders.map(h => `<th class="text-left text-xs font-semibold text-slate-300 pb-2.5 pt-1 px-3 border-b border-slate-700">${h}</th>`).join('');
        const bodyRows = page.breakdownRows.map(row => `
          <tr class="hover:bg-slate-750/50 border-b border-slate-700/40 text-xs text-slate-200 transition">
            <td class="py-2.5 px-3 font-medium text-white">${row[0]}</td>
            <td class="py-2.5 px-3 text-slate-300 font-mono">${row[1]}</td>
            <td class="py-2.5 px-3 text-slate-300 font-mono">${row[2]}</td>
            <td class="py-2.5 px-3 text-slate-300 font-mono">${row[3]}</td>
            <td class="py-2.5 px-3 text-emerald-400 font-mono font-semibold">${row[4]}</td>
          </tr>
        `).join('');

        detailSectionHtml = `
          <div class="bg-slate-800/60 rounded-xl p-4 border border-slate-700/80 mt-4">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-300">${page.breakdownTitle}</h3>
              <span class="text-[10px] text-slate-400">Synthesized Executive View</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead><tr>${headerCols}</tr></thead>
                <tbody>${bodyRows}</tbody>
              </table>
            </div>
          </div>
        `;
      }

      // If page has Zone/Market benchmark cards
      if (page.benchmarks) {
        const benchmarkItems = page.benchmarks.map(b => `
          <div class="flex items-center justify-between p-3 rounded-lg bg-slate-900/60 border border-slate-700">
            <div>
              <div class="text-xs font-semibold text-white">${b.metric}</div>
              <div class="text-[10px] text-slate-400 mt-0.5">Your Store: <span class="font-bold text-blue-400 font-mono">${b.store}</span></div>
            </div>
            <div class="flex items-center space-x-3 text-right">
              <div>
                <div class="text-[10px] text-slate-400">Zone Avg</div>
                <div class="text-xs font-mono font-medium text-slate-200">${b.zone}</div>
              </div>
              <div>
                <div class="text-[10px] text-slate-400">Region Avg</div>
                <div class="text-xs font-mono font-medium text-slate-200">${b.region}</div>
              </div>
              <div>
                <div class="text-[10px] text-slate-400">National</div>
                <div class="text-xs font-mono font-medium text-slate-200">${b.national}</div>
              </div>
            </div>
          </div>
        `).join('');

        detailSectionHtml = `
          <div class="bg-slate-800/60 rounded-xl p-4 border border-slate-700/80 mt-4">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-300">${page.benchmarkTitle}</h3>
              <span class="text-[10px] text-emerald-400 font-medium">✓ Exceeding Zone Average</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              ${benchmarkItems}
            </div>
          </div>
        `;
      }

      container.innerHTML = `
        <!-- Section Page Header -->
        <div class="mb-4">
          <div class="flex items-center space-x-2 text-blue-400 text-xs font-semibold uppercase tracking-wider">
            <span>Review Stream</span>
            <span>•</span>
            <span>${currentDealerData.dealer.name}</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">${page.title}</h2>
          <p class="text-xs text-slate-400 mt-0.5">${page.subtitle}</p>
        </div>

        <!-- 3 to 5 Primary Outcome Cards (Spec 6.3) -->
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-3">
          ${metricsHtml}
        </div>

        <!-- Presenter Speaking Anchor Card -->
        <div class="mt-4 bg-gradient-to-r from-blue-950/40 via-slate-800/80 to-slate-800/80 border border-blue-900/50 rounded-xl p-3.5 flex items-start space-x-3">
          <div class="bg-blue-600/30 text-blue-400 p-1.5 rounded-md mt-0.5">
            <i data-lucide="message-square-quote" class="w-4 h-4"></i>
          </div>
          <div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-blue-400">Presenter Key Takeaway & Discussion Driver</div>
            <p class="text-xs text-slate-200 mt-0.5 leading-relaxed font-normal">${page.talkingPoint}</p>
          </div>
        </div>

        <!-- Supporting Detail Section (Synthesized, no horizontal scrolling) -->
        ${detailSectionHtml}
      `;

      lucide.createIcons();
    }

    // Launch
    window.addEventListener('DOMContentLoaded', init);
  </script>
</body>
</html>
